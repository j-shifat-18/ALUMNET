generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  STUDENT
  ALUMNI
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id Int @id @default(autoincrement())

  uid String @unique

  name     String
  username String? @unique
  email    String  @unique

  role   Role       @default(USER)
  status UserStatus @default(ACTIVE)

  gender    String?
  contactNo String?

  bio      String?
  location String?

  profileImage String?
  coverImage   String?

  followersCount Int @default(0)
  followingCount Int @default(0)

  isVerified        Boolean @default(false)
  isMentorAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  alumniProfile  AlumniProfile?
  adminProfile   AdminProfile?

  // profileCompleted Boolean @default(false)

  posts    Post[]
  postLikes PostLike[]
  comments Comment[]

  // Follow System
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  // Mentorship System
  sentMentorshipRequests     MentorshipRequest[] @relation("StudentRequests")
  receivedMentorshipRequests MentorshipRequest[] @relation("AlumniRequests")

  // Events
  organizedEvents Event[]         @relation("EventOrganizer")
  eventAttendees  EventAttendee[]
  taskMessages    TaskMessage[]

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id Int @id @default(autoincrement())

  userId Int @unique

  department String
  program    String
  batch      String

  careerGoal String?

  interestedDomains String[]
  skills            String[]

  currentCompany  String?
  currentPosition String?

  resumeUrl    String?
  portfolioUrl String?
  githubUrl    String?

  certifications String[]
  achievements   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([department])
  @@index([batch])
  @@index([program])
}

model AlumniProfile {
  id Int @id @default(autoincrement())

  userId Int @unique

  department String
  program    String
  batch      String

  graduationYear Int

  currentCompany  String?
  currentPosition String?
  industry        String?

  experienceYears Int?

  interestedDomains String[]
  skills            String[]
  expertiseAreas    String[]

  education      String?
  certifications String[]
  achievements   String[]

  resumeUrl       String?
  githubUrl       String?
  portfolioUrl    String?
  personalWebsite String?

  mentorshipDomains String[]

  totalMentees Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([department])
  @@index([currentCompany])
  @@index([graduationYear])
}

model AdminProfile {
  id Int @id @default(autoincrement())

  userId Int @unique

  designation String?

  permissions String[]

  managedReports   Int @default(0)
  bannedUsersCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

model Post {
  id Int @id @default(autoincrement())

  authorId Int

  content String

  imageUrl String?

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  likes PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId],references: [id],onDelete: Cascade)

  comments Comment[]

  @@index([authorId])
}

model Comment {
  id Int @id @default(autoincrement())

  content String

  userId Int
  postId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  post Post @relation(fields: [postId],references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([postId])
}

model Follow {
  followerId Int
  followingId Int

  createdAt DateTime @default(now())

  follower User @relation("UserFollowing",fields: [followerId],references: [id],onDelete: Cascade)

  following User @relation("UserFollowers",fields: [followingId],references: [id],onDelete: Cascade)

  @@id([followerId, followingId])

  @@index([followerId])
  @@index([followingId])
}

model MentorshipRequest {
  id Int @id @default(autoincrement())

  studentId Int
  alumniId  Int

  message String?

  status RequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentRequests", fields: [studentId],references: [id],onDelete: Cascade)

  alumni User @relation("AlumniRequests",fields: [alumniId],references: [id],onDelete: Cascade)

  sessions MentorshipSession[]

  @@index([studentId])
  @@index([alumniId])
  @@index([status])
  @@unique([studentId, alumniId])
}

model MentorshipSession {
  id Int @id @default(autoincrement())

  mentorshipRequestId Int

  title       String
  description String?

  tasks MentorshipTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorshipRequest MentorshipRequest @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)

  @@index([mentorshipRequestId])
}

model MentorshipTask {
  id Int @id @default(autoincrement())

  sessionId Int

  title       String
  description String?
  isCompleted Boolean   @default(false)
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages TaskMessage[]

  @@index([sessionId])
}

model TaskMessage {
  id Int @id @default(autoincrement())

  taskId   Int
  senderId Int

  content     String
  messageType String @default("GENERAL")

  createdAt DateTime @default(now())

  task   MentorshipTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([senderId])
}

model PostLike {
  userId Int
  postId Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  post Post @relation(fields: [postId],references: [id],onDelete: Cascade)

  @@id([userId, postId])

  @@index([userId])
  @@index([postId])
}

model Event {
  id Int @id @default(autoincrement())

  title       String
  description String
  type        String

  date    DateTime
  endDate DateTime?

  location String?
  link     String?

  organizerId Int

  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  attendees EventAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([date])
}

model EventAttendee {
  userId  Int
  eventId Int

  registeredAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}