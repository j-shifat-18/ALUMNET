generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  uid        String   @unique
  name        String
  email       String   @unique
  batch       String?

  photoURL    String?
  bio         String?  @db.Text
  preferences String[]
  github      String?
  resume      String?
  about       String?  @db.Text
  skills      String[]

  createdAt   DateTime @default(now())
}
